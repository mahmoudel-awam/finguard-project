# ============================================
# FinGuard — .gitignore
# ============================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.venv/

# Generated data files — never commit
*.csv
*.json.bak
transactions_hive.csv

# Spark runtime
spark-logs/
checkpoints/
derby.log
metastore_db/

# Logs
logs/
*.log

# Docker volumes (local only)
postgres_data/
grafana_data/
hbase_data/
zookeeper_data/
kafka_data/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.iml

# Environment variables (NEVER commit secrets)
.env
.env.local
secrets.yaml

# Jupyter
.ipynb_checkpoints/
*.ipynb
